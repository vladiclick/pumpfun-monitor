# ---------------------------------------------------------------------------
# Configurare globala backend + boti. Copiaza in `.env` si ajusteaza.
# Toate valorile implicite sunt gratuite (RPC public Solana).
# ---------------------------------------------------------------------------

# RPC HTTP folosit pentru getTransaction / getAccountInfo
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com

# RPC WebSocket folosit pentru logsSubscribe.
# Daca il lasi gol, se deduce automat din SOLANA_RPC_HTTP (http->ws, https->wss).
# Exemplu Helius free tier (fara card):
#   SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=CHEIA_TA
#   SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=CHEIA_TA
SOLANA_RPC_WS=

# Adresa serverului FastAPI catre care botii trimit evenimente
BACKEND_URL=http://127.0.0.1:8000

# Secret partajat intre boti si backend pentru endpoint-ul de ingest.
# Schimba-l cu orice sir aleator inainte sa expui dashboardul public.
INGEST_TOKEN=schimba-ma-cu-ceva-random

# Token pentru dashboard (REST + WebSocket). Gol = deschis, potrivit doar local.
# OBLIGATORIU inainte sa expui dashboardul public (Cloudflare Tunnel etc.),
# altfel oricine are linkul poate porni si opri boti.
# Genereaza cu: openssl rand -hex 24
# Dashboardul il preia din URL o singura data: http://host/?token=VALOAREA
DASHBOARD_TOKEN=

# Notificari Telegram cand un token trece toate filtrele (verdict PASS).
# Optional. TELEGRAM_BOT_TOKEN gol = functia e complet dezactivata, fara
# erori, nimic nu se schimba. Token-ul se obtine de la @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Chatul (sau grupul) unde se trimit notificarile. Daca lipseste cat timp
# TELEGRAM_BOT_TOKEN e setat, botul il descopera singur la pornire, il
# afiseaza in log si se opreste (exit code 3) - vezi README, sectiunea
# Notificari Telegram.
TELEGRAM_CHAT_ID=

# Fisierul SQLite cu istoricul evenimentelor
DB_PATH=data/events.db

# Nivel logging: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Origini permise pentru CORS (separate prin virgula, * = toate)
CORS_ORIGINS=*
